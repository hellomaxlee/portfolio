---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page not found · Maxwell Lee" description="This page does not exist.">
  <meta slot="head" name="robots" content="noindex" />
  <main id="main" class="wrap lost">
    <h1>Page not found</h1>
    <p>There is nothing at this address.</p>
    <p><a href={`${base}/`}>Back to the home page</a></p>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    gap: var(--space-4);
    padding-block: clamp(4rem, 2rem + 10vw, 9rem);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.022em;
  }
</style>
