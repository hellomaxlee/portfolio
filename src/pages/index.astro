---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import NetworkMap from '../components/NetworkMap.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const built = projects.filter((p) => p.data.kind === 'built');
const quests = await Promise.all(
  projects
    .filter((p) => p.data.kind === 'quest')
    .map(async (p) => ({ ...p, Content: (await render(p)).Content })),
);

const email = 'maxwelllee12@gmail.com';
const linkedin = 'https://www.linkedin.com/in/maxwelllee12/';
const github = 'https://github.com/hellomaxlee';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Maxwell Lee"
  description="Maxwell Lee works in economic consulting in New York and builds apps on the side."
>
  <div class="sky top" id="top">
    <header class="wrap bar">
      <a class="mark" href="#top">Maxwell Lee</a>
      <nav aria-label="Sections">
        <ul>
          <li><a href="#about">Work</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#quests">Side quests</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <section class="wrap hero">
      <div class="intro">
        <h1>I'm Max. I work in economic consulting and build apps on the side.</h1>
        <p class="lede">
          Based in New York. I'm a public transit enthusiast, which explains most of what's on
          this page.
        </p>
        <ul class="actions">
          <li><a class="button" href={`mailto:${email}`}>Email</a></li>
          <li><a href={linkedin} rel="noopener">LinkedIn</a></li>
          <li><a href={github} rel="noopener">GitHub</a></li>
        </ul>
      </div>
      <div class="map">
        <NetworkMap />
      </div>
    </section>
  </div>

  <main id="main">
    <section
      class="wrap section two"
      id="about"
      aria-labelledby="about-h"
      style="--line:var(--line-work)"
    >
      <div>
        <h2 id="about-h"><span class="swatch"></span>Work</h2>
        <img class="portrait" src={`${base}/max.jpg`} alt="Max Lee" width="460" height="460" />
      </div>
      <div class="prose">
        <p>
          I'm an analyst at The Brattle Group, an economic consulting firm, on competition,
          consumer protection, and transportation cases. I also help the firm test where AI tools
          are worth using.
        </p>
        <p>
          Before that I spent one summer at the Consumer Financial Protection Bureau, through a
          Princeton technology policy fellowship, and another at the Treasury. I studied
          economics, math, and statistics at Hamilton College, with a semester in Stockholm.
        </p>
      </div>
    </section>

    <section
      class="wrap section"
      id="projects"
      aria-labelledby="projects-h"
      style="--line:var(--line-build)"
    >
      <h2 id="projects-h"><span class="swatch"></span>Things I've built</h2>
      <div class="grid">
        {built.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section
      class="wrap section two"
      id="quests"
      aria-labelledby="quests-h"
      style="--line:var(--line-quest)"
    >
      <div>
        <h2 id="quests-h"><span class="swatch"></span>Side quests</h2>
        <p class="note">
          I like giving trips rules and goals. Most of them involve public transit.
        </p>
      </div>
      <ol class="quests">
        {
          quests.map((quest) => (
            <li id={quest.id}>
              <h3>{quest.data.title}</h3>
              <p class="q-fact">
                <span class="q-stat">{quest.data.stat}</span>
                <span class="q-label">{quest.data.statLabel}</span>
              </p>
              <div class="q-text">
                <quest.Content />
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer class="sky foot" id="contact">
    <div class="wrap">
      <h2>Get in touch</h2>
      <p><a class="email" href={`mailto:${email}`}>{email}</a></p>
      <ul class="elsewhere">
        <li><a href={linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={github} rel="noopener">GitHub</a></li>
      </ul>
      <p class="fine">© {new Date().getFullYear()} Maxwell Lee</p>
    </div>
  </footer>
</Base>

<style>
  /* Top band */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5);
  }

  .mark {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-size: var(--step--1);
  }

  nav a {
    color: var(--on-sky-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--on-sky);
  }

  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(1.5rem, 1rem + 3vw, 3.5rem) clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  @media (min-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 9fr);
      gap: var(--space-6);
      align-items: center;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .lede {
    margin-top: var(--space-4);
    color: var(--on-sky-muted);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 30rem;
  }

  @media (max-width: 40rem) {
    .lede,
    .prose {
      font-size: var(--step-0);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
    font-weight: 600;
  }

  .button {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    background: var(--on-sky);
    color: var(--sky);
    text-decoration: none;
  }

  .button:hover {
    background: var(--map-work);
  }

  /* Sections on paper */
  .section {
    padding-top: var(--space-8);
  }

  @media (min-width: 56rem) {
    .two {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-7);
      align-items: start;
    }
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* A short length of the section's line, ending in a station. */
  .swatch {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--line);
  }

  .swatch::after {
    content: '';
    position: absolute;
    right: -0.25rem;
    top: 50%;
    width: 0.875rem;
    height: 0.875rem;
    translate: 0 -50%;
    border-radius: 50%;
    border: 3px solid var(--ink);
    background: var(--bg);
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .note {
    color: var(--muted);
    max-width: 22rem;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Side quests: a plain list, number first */
  .portrait {
    display: block;
    width: 9rem;
    height: 9rem;
    margin-bottom: var(--space-5);
    border-radius: var(--radius);
    object-fit: cover;
  }

  /* The quest line from the map continues down the list, one station per entry. */
  .quests {
    display: grid;
    gap: var(--space-6);
    border-left: 4px solid var(--line);
    padding-left: var(--space-5);
  }

  @media (max-width: 56rem) {
    .quests {
      margin-top: var(--space-5);
    }
  }

  .quests li {
    position: relative;
    scroll-margin-top: 2rem;
  }

  .quests li::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-5) - 2px - 0.375rem);
    top: 0.4rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 3px solid var(--ink);
    background: var(--bg);
  }

  .quests h3 {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
  }

  /* Number and unit read as one phrase. */
  .q-fact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.45rem;
    margin-top: var(--space-1);
  }

  .q-stat {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--line);
    font-variant-numeric: lining-nums;
  }

  .q-label {
    color: var(--muted);
  }

  .q-text {
    margin-top: var(--space-2);
    max-width: 36rem;
    text-wrap: pretty;
  }

  .prose p {
    text-wrap: pretty;
  }

  /* Footer */
  .foot {
    margin-top: var(--space-8);
    padding-block: var(--space-7) var(--space-6);
  }

  .foot h2 {
    margin-bottom: var(--space-3);
    color: var(--on-sky-muted);
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .email {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1rem + 2.2vw, 2.25rem);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .elsewhere {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-5);
    font-weight: 600;
  }

  .fine {
    margin-top: var(--space-7);
    color: var(--on-sky-muted);
    font-size: var(--step--1);
  }
</style>
