---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import NetworkMap from '../components/NetworkMap.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const built = projects.filter((p) => p.data.kind === 'built');
const quests = await Promise.all(
  projects
    .filter((p) => p.data.kind === 'quest')
    .map(async (p) => ({ ...p, Content: (await render(p)).Content })),
);

const email = 'maxwelllee12@gmail.com';
const linkedin = 'https://www.linkedin.com/in/maxwelllee12/';
const github = 'https://github.com/hellomaxlee';
const cooking = 'https://www.instagram.com/byemaxlee/';
// One track change: down, a 45 degree diagonal with rounded corners, down again.
const jog = 'M0 0V.25Q0 .5 .18 .68L.82 1.32Q1 1.5 1 1.75V2';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Maxwell Lee"
  description="Maxwell Lee works in economic consulting in New York and builds apps on the side."
>
  <div class="sky top" id="top">
    <header class="wrap bar">
      <a class="mark" href="#top">Maxwell Lee</a>
      <nav aria-label="Sections">
        <ul>
          <li><a href="#about">Work</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#quests">Side quests</a></li>
        </ul>
      </nav>
    </header>

    <section class="wrap hero">
      <div class="intro">
        <h1>I'm Max. I work in economic consulting and build apps on the side.</h1>
        <p class="lede">
          Based in New York. I'm a public transit enthusiast, which explains most of what's on
          this page.
        </p>
        <ul class="actions">
          <li><a href={`mailto:${email}`}>Email</a></li>
          <li><a href={linkedin} rel="noopener">LinkedIn</a></li>
          <li><a href={github} rel="noopener">GitHub</a></li>
        </ul>
      </div>
      <div class="map">
        <NetworkMap />
      </div>
    </section>
  </div>

  <main id="main">
    <section
      class="wrap section two"
      id="about"
      aria-labelledby="about-h"
      style="--line:var(--line-work)"
    >
      <div>
        <h2 id="about-h"><span class="swatch"></span>Work</h2>
        <img class="portrait" src={`${base}/max.jpg`} alt="Max Lee" width="460" height="460" />
      </div>
      <div class="prose">
        <p>
          I'm an analyst at <a href="https://www.brattle.com/" rel="noopener">The Brattle Group</a>,
          an economic consulting firm, and work on complex competition, consumer protection, and
          transportation litigation cases. I also help the firm test where AI tools are worth
          using.
        </p>
        <p>
          Before that I spent one summer at the <a href="https://www.consumerfinance.gov/" rel="noopener">Consumer Financial Protection Bureau</a>,
          through a <a href="https://www.princeton.edu/" rel="noopener">Princeton University</a> technology
          policy fellowship, and another at the Treasury. I studied economics, math, and
          statistics at <a href="https://www.hamilton.edu/" rel="noopener">Hamilton College</a>.
        </p>
      </div>
    </section>

    <section
      class="wrap section"
      id="projects"
      aria-labelledby="projects-h"
      style="--line:var(--line-build)"
    >
      <h2 id="projects-h"><span class="swatch"></span>Things I've built</h2>
      <div class="grid">
        {built.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section
      class="wrap section two"
      id="quests"
      aria-labelledby="quests-h"
      style="--line:var(--line-quest)"
    >
      <div class="q-head">
        <h2 id="quests-h"><span class="swatch"></span>Side quests</h2>
        <p class="note">
          I like giving trips rules and goals. Most of them involve public transit. As I've gotten
          older I also take the occasional one with no plan at all, which I hear is how a lot of
          people travel.
        </p>
        <svg class="q-fork q-fork-side" viewBox="0 0 40 60" aria-hidden="true">
          <path d="M40 0V2.2Q40 8 35.9 12.1L4.1 43.9Q0 48 0 53.8V60" />
        </svg>
        <svg class="q-fork q-fork-turn" viewBox="0 0 28 40" aria-hidden="true">
          <path d="M28 0V14.2Q28 20 23.9 24.1L12.1 35.9Q8 40 2.2 40H0" />
        </svg>
        <p class="q-side">
          <svg class="q-fork q-fork-top" viewBox="0 0 56 34" aria-hidden="true">
            <path d="M0 34V16Q0 12 2.8 9.2L9.2 2.8Q12 0 16 0H56" />
          </svg>
          <a href={cooking} rel="noopener">Cooking on Instagram</a>
        </p>
      </div>
      <ol class="quests">
        {
          quests.map((quest, i) => (
            <li id={quest.id}>
              {i === 0 && (
                <svg class="q-jog q-lead" viewBox="0 0 1 2" aria-hidden="true">
                  <path d={jog} />
                </svg>
              )}
              <h3>{quest.data.title}</h3>
              <p class="q-fact">
                <span class="q-stat">{quest.data.stat}</span>
                <span class="q-label">{quest.data.statLabel}</span>
              </p>
              <div class="q-text">
                <quest.Content />
              </div>
              {i < quests.length - 1 && (
                <svg class="q-jog" viewBox="0 0 1 2" aria-hidden="true">
                  <path d={jog} />
                </svg>
              )}
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer class="sky foot" id="contact">
    <div class="wrap">
      <h2>Get in touch</h2>
      <ul class="actions">
        <li><a href={`mailto:${email}`}>Email</a></li>
        <li><a href={linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={github} rel="noopener">GitHub</a></li>
      </ul>
      <p class="fine">© {new Date().getFullYear()} Maxwell Lee</p>
    </div>
  </footer>
</Base>

<style>
  /* Top band */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5);
  }

  .mark {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-size: var(--step--1);
  }

  nav a {
    color: var(--on-sky-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--on-sky);
  }

  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(1.5rem, 1rem + 3vw, 3.5rem) clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  @media (min-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 9fr);
      gap: var(--space-6);
      align-items: center;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .lede {
    margin-top: var(--space-4);
    color: var(--on-sky-muted);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 30rem;
  }

  @media (max-width: 40rem) {
    .lede,
    .prose {
      font-size: var(--step-0);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
    font-weight: 600;
  }

  /* Sections on paper */
  .section {
    padding-top: var(--space-8);
  }

  @media (min-width: 56rem) {
    .two {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-7);
      align-items: start;
    }
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* A short length of the section's line, ending in a station. */
  .swatch {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--line);
  }

  .swatch::after {
    content: '';
    position: absolute;
    right: -0.25rem;
    top: 50%;
    width: 0.875rem;
    height: 0.875rem;
    translate: 0 -50%;
    border-radius: 50%;
    border: 3px solid var(--ink);
    background: var(--bg);
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .note {
    color: var(--muted);
    max-width: 22rem;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .portrait {
    display: block;
    width: 9rem;
    height: 9rem;
    margin-bottom: var(--space-5);
    border-radius: var(--radius);
    object-fit: cover;
  }

  /*
    The quest line from the map continues down the list. It runs on two tracks and changes
    track between entries, so each station sits on the track its entry starts on.
  */
  .quests {
    --near: 0.375rem;
    --shift: var(--space-3);
    --q-stroke: 4px;
    --clear: var(--space-4);
    padding-top: calc(2 * var(--shift));
  }

  @media (max-width: 56rem) {
    .quests {
      margin-top: var(--space-5);
    }
  }

  @media (min-width: 40rem) {
    .quests {
      --shift: var(--space-5);
      --clear: var(--space-5);
    }
  }

  /* Beside the heading, the lead-in rises above the list so the first title stays level with it. */
  @media (min-width: 56rem) {
    .quests {
      margin-top: calc(-2 * var(--shift));
    }
  }

  /*
    A short dashed fork leaves the top of the quest line for a stop that is off this page. Beside
    the heading it drops down the gap between the columns; stacked, it sits above the list.
  */
  .q-head {
    --near: 0.375rem;
    --fork-stroke: 2.5px;
    --fork-x: 0.875rem;
    position: relative;
  }

  .q-fork {
    position: absolute;
    overflow: visible;
    fill: none;
    stroke: var(--line);
    stroke-width: var(--fork-stroke);
    stroke-dasharray: 5 4;
  }

  .q-fork-side {
    display: none;
  }

  .q-fork-top {
    left: var(--near);
    top: 0.625rem;
    width: 3.5rem;
    height: 2.125rem;
  }

  .q-side {
    position: relative;
    margin-top: var(--space-5);
    padding-left: calc(var(--near) + 3.5rem + 0.875rem);
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.25rem;
  }

  .q-side::after {
    content: '';
    position: absolute;
    z-index: 1;
    left: calc(var(--near) + 3.5rem - 0.3125rem);
    top: 0.3125rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--bg);
  }

  .q-fork-turn {
    display: none;
  }

  /*
    Beside the heading: down the gap between the columns, then a 45 degree turn left under the
    intro, ending at a stop whose label keeps the column's left edge.
  */
  @media (min-width: 56rem) {
    .q-fork-top {
      display: none;
    }

    .q-fork-side {
      display: block;
      left: calc(100% + var(--fork-x));
      top: calc(-2 * var(--space-5));
      width: 2.5rem;
      height: 3.75rem;
    }

    .q-head::after {
      content: '';
      position: absolute;
      left: calc(100% + var(--fork-x) - var(--fork-stroke) / 2);
      top: 0.75rem;
      bottom: 3.125rem;
      width: var(--fork-stroke);
      background: repeating-linear-gradient(to bottom, var(--line) 0 5px, transparent 5px 9px);
    }

    .q-fork-turn {
      display: block;
      left: calc(100% + var(--fork-x) - 1.75rem);
      bottom: 0.625rem;
      width: 1.75rem;
      height: 2.5rem;
    }

    .q-side {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding-left: 0;
      padding-right: calc(1.75rem - var(--fork-x));
    }

    .q-side::after {
      position: static;
      flex: none;
      order: 1;
    }

    .q-side::before {
      content: '';
      order: 2;
      flex: 1;
      height: var(--fork-stroke);
      margin-left: calc(-1 * var(--space-2));
      background: repeating-linear-gradient(to left, var(--line) 0 5px, transparent 5px 9px);
    }
  }

  .quests li {
    --track: var(--near);
    position: relative;
    padding-left: calc(var(--near) + var(--shift) + var(--clear));
    padding-bottom: var(--space-6);
    scroll-margin-top: 3.5rem;
  }

  .quests li:nth-child(odd) {
    --track: calc(var(--near) + var(--shift));
  }

  .quests li:last-child {
    padding-bottom: var(--space-2);
  }

  .quests li::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: calc(var(--track) - 0.375rem);
    top: 0.4rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 3px solid var(--ink);
    background: var(--bg);
  }

  /* Arriving from the map fills the station. */
  .quests li:target::before {
    border-width: 2px;
    background: var(--line);
  }

  @media (prefers-reduced-motion: no-preference) {
    .quests li::before {
      transition:
        background-color 0.3s ease,
        border-width 0.3s ease;
    }
  }

  .quests li + li::after {
    top: -1px;
  }

  .quests li::after {
    content: '';
    position: absolute;
    left: calc(var(--track) - var(--q-stroke) / 2);
    top: 0;
    bottom: calc(2 * var(--shift) - 1px);
    width: var(--q-stroke);
    background: var(--line);
  }

  /* The last entry has no track change; its line ends in a terminus bar. */
  .quests li:last-child::after {
    left: calc(var(--track) - 0.5rem);
    bottom: 0;
    width: 1rem;
    background:
      linear-gradient(var(--line) 0 0) center / var(--q-stroke) 100% no-repeat,
      linear-gradient(var(--line) 0 0) bottom / 100% var(--q-stroke) no-repeat;
  }

  .q-jog {
    position: absolute;
    left: var(--near);
    bottom: 0;
    width: var(--shift);
    height: calc(2 * var(--shift));
    overflow: visible;
    fill: none;
    stroke: var(--line);
    stroke-width: var(--q-stroke);
  }

  .q-jog path {
    vector-effect: non-scaling-stroke;
  }

  .quests li:nth-child(odd) > .q-jog:not(.q-lead) {
    scale: -1 1;
  }

  .q-lead {
    bottom: 100%;
    stroke-linecap: round;
  }

  .quests h3 {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
  }

  /* Number and unit read as one phrase. */
  .q-fact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.45rem;
    margin-top: var(--space-1);
  }

  .q-stat {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--line);
    font-variant-numeric: lining-nums;
  }

  .q-label {
    color: var(--muted);
  }

  .q-text {
    margin-top: var(--space-2);
    max-width: 36rem;
    text-wrap: pretty;
  }

  .prose p {
    text-wrap: pretty;
  }

  /* Footer */
  .foot {
    margin-top: var(--space-8);
    padding-block: var(--space-7) var(--space-6);
  }

  .foot h2 {
    margin-bottom: var(--space-3);
    color: var(--on-sky-muted);
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .foot .actions {
    margin-top: 0;
  }

  .fine {
    margin-top: var(--space-7);
    color: var(--on-sky-muted);
    font-size: var(--step--1);
  }
</style>
