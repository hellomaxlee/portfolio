---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import NetworkMap from '../components/NetworkMap.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const built = projects.filter((p) => p.data.kind === 'built');
const quests = await Promise.all(
  projects
    .filter((p) => p.data.kind === 'quest')
    .map(async (p) => ({ ...p, Content: (await render(p)).Content })),
);

// Wide screens place each entry left or right of the line. An entry starts on its own row and
// runs until the next entry on its side; the heading block does the same on the left.
const lastRow = quests.length + 1;
const sides = quests.map((q) => q.data.side);
const spans = sides.map((side, i) => {
  const next = sides.findIndex((s, j) => j > i && s === side);
  return (next === -1 ? lastRow : next) - i;
});
const firstLeft = sides.indexOf('left');
const headSpan = firstLeft === -1 ? lastRow : Math.max(1, firstLeft);

const email = 'maxwelllee12@gmail.com';
const linkedin = 'https://www.linkedin.com/in/maxwelllee12/';
const github = 'https://github.com/hellomaxlee';
// One track change: down, a 45 degree diagonal with rounded corners, down again.
const jog = 'M0 0V.25Q0 .5 .18 .68L.82 1.32Q1 1.5 1 1.75V2';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Maxwell Lee"
  description="Maxwell Lee works in economic consulting in New York and builds apps on the side."
>
  <div class="sky top" id="top">
    <header class="wrap bar">
      <a class="mark" href="#top">Maxwell Lee</a>
      <nav aria-label="Sections">
        <ul>
          <li><a href="#about">Work</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#quests">Side quests</a></li>
        </ul>
      </nav>
    </header>

    <section class="wrap hero">
      <div class="intro">
        <h1>I'm Max. I work in economic consulting and build apps on the side.</h1>
        <p class="lede">
          Based in New York. I'm a public transit enthusiast, which explains most of what's on
          this page.
        </p>
        <ul class="actions">
          <li><a href={`mailto:${email}`}>Email</a></li>
          <li><a href={linkedin} rel="noopener">LinkedIn</a></li>
          <li><a href={github} rel="noopener">GitHub</a></li>
        </ul>
      </div>
      <div class="map">
        <NetworkMap />
      </div>
    </section>
  </div>

  <main id="main">
    <section
      class="wrap section two"
      id="about"
      aria-labelledby="about-h"
      style="--line:var(--line-work)"
    >
      <div>
        <h2 id="about-h"><span class="swatch"></span>Work</h2>
        <img class="portrait" src={`${base}/max.jpg`} alt="Max Lee" width="460" height="460" />
      </div>
      <div class="prose">
        <p>
          I'm an analyst at <a href="https://www.brattle.com/" rel="noopener">The Brattle Group</a>,
          an economic consulting firm, and work on complex competition, consumer protection, and
          transportation litigation cases. I also help the firm test where AI tools are worth
          using.
        </p>
        <p>
          Before that I spent one summer at the <a href="https://www.consumerfinance.gov/" rel="noopener">Consumer Financial Protection Bureau</a>,
          through a <a href="https://www.princeton.edu/" rel="noopener">Princeton University</a> technology
          policy fellowship, and another at the <a href="https://home.treasury.gov/" rel="noopener">Treasury</a>. Both federal roles were during
          the Biden presidency. I studied economics, math, and statistics at
          <a href="https://www.hamilton.edu/" rel="noopener">Hamilton College</a>.
        </p>
      </div>
    </section>

    <section
      class="wrap section"
      id="projects"
      aria-labelledby="projects-h"
      style="--line:var(--line-build)"
    >
      <h2 id="projects-h"><span class="swatch"></span>Things I've built</h2>
      <div class="grid">
        {built.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section
      class="wrap section two"
      id="quests"
      aria-labelledby="quests-h"
      style={`--line:var(--line-quest);--rows:${lastRow};--head-span:${headSpan}`}
    >
      <div class="q-head">
        <h2 id="quests-h"><span class="swatch"></span>Side quests</h2>
        <p class="note">
          I like giving trips rules and goals. Most of them involve public transit. As I've gotten
          older I also take the occasional one with no plan at all, which I hear is how a lot of
          people travel.
        </p>
      </div>
      <ol class="quests">
        {
          quests.map((quest, i) => (
            <li id={quest.id} class={`q-${sides[i]}`} style={`--row:${i + 1};--span:${spans[i]}`}>
              {i === 0 && (
                <svg class="q-jog q-lead" viewBox="0 0 1 2" aria-hidden="true">
                  <path d={jog} />
                </svg>
              )}
              <h3>{quest.data.title}</h3>
              <p class="q-fact">
                <span class="q-stat">{quest.data.stat}</span>
                <span class="q-label">{quest.data.statLabel}</span>
              </p>
              <div class="q-text">
                <quest.Content />
              </div>
              {i < quests.length - 1 && (
                <svg class="q-jog" viewBox="0 0 1 2" aria-hidden="true">
                  <path d={jog} />
                </svg>
              )}
            </li>
          ))
        }
      </ol>
      {
        quests.map((_, i) => (
          <span
            class:list={[
              'q-seg',
              `q-on-${sides[i]}`,
              { 'q-seg-end': i === quests.length - 1, 'q-straight': sides[i] === sides[i + 1] },
            ]}
            style={`--row:${i + 1}`}
            aria-hidden="true"
          >
            {i < quests.length - 1 && sides[i] !== sides[i + 1] && (
              <svg class="q-jog" viewBox="0 0 1 2">
                <path d={jog} />
              </svg>
            )}
          </span>
        ))
      }
    </section>
  </main>

  <footer class="sky foot" id="contact">
    <div class="wrap">
      <h2>Get in touch</h2>
      <ul class="actions">
        <li><a href={`mailto:${email}`}>Email</a></li>
        <li><a href={linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={github} rel="noopener">GitHub</a></li>
      </ul>
      <p class="fine">© {new Date().getFullYear()} Maxwell Lee</p>
    </div>
  </footer>
</Base>

<style>
  /* Top band */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5);
  }

  .mark {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.005em;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-size: var(--step--1);
  }

  nav a {
    color: var(--on-sky-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--on-sky);
  }

  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(1rem, 0.5rem + 2.5vw, 2.5rem) clamp(2rem, 1.25rem + 3vw, 3.5rem);
  }

  @media (min-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 9fr);
      gap: var(--space-6);
      align-items: center;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .lede {
    margin-top: var(--space-4);
    color: var(--on-sky-muted);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 30rem;
  }

  @media (max-width: 40rem) {
    .lede,
    .prose {
      font-size: var(--step-0);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
    font-weight: 600;
  }

  /* Sections on paper */
  .section {
    padding-top: var(--space-8);
  }

  @media (min-width: 56rem) {
    .two {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-7);
      align-items: start;
    }
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  /* A short length of the section's line, ending in a station. */
  .swatch {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--line);
  }

  .swatch::after {
    content: '';
    position: absolute;
    right: -0.25rem;
    top: 50%;
    width: 0.875rem;
    height: 0.875rem;
    translate: 0 -50%;
    border-radius: 50%;
    border: 3px solid var(--ink);
    background: var(--bg);
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .note {
    color: var(--muted);
    max-width: 22rem;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .portrait {
    display: block;
    width: 9rem;
    height: 9rem;
    margin-bottom: var(--space-5);
    border-radius: var(--radius);
    object-fit: cover;
  }

  /*
    The quest line from the map continues down the list. It runs on two tracks and changes
    track between entries, so each station sits on the track its entry starts on.
  */
  #quests {
    --near: 0.375rem;
    --shift: var(--space-3);
    --q-stroke: 4px;
    --clear: var(--space-4);
  }

  .quests {
    padding-top: calc(2 * var(--shift));
  }

  .q-seg {
    display: none;
  }

  @media (max-width: 56rem) {
    .quests {
      margin-top: var(--space-5);
    }
  }

  @media (min-width: 40rem) {
    #quests {
      --shift: var(--space-5);
      --clear: var(--space-5);
    }
  }

  /* Beside the heading, the lead-in rises above the list so the first title stays level with it. */
  @media (min-width: 56rem) {
    .quests {
      margin-top: calc(-2 * var(--shift));
    }
  }

  .quests li {
    --track: var(--near);
    position: relative;
    padding-left: calc(var(--near) + var(--shift) + var(--clear));
    padding-bottom: var(--space-6);
    scroll-margin-top: 3.5rem;
  }

  .quests li:nth-child(odd) {
    --track: calc(var(--near) + var(--shift));
  }

  .quests li:last-child {
    padding-bottom: var(--space-2);
  }

  .quests li::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: calc(var(--track) - 0.375rem);
    top: 0.4rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 3px solid var(--ink);
    background: var(--bg);
  }

  /* Arriving from the map fills the station. */
  .quests li:target::before {
    border-width: 2px;
    background: var(--line);
  }

  @media (prefers-reduced-motion: no-preference) {
    .quests li::before {
      transition:
        background-color 0.3s ease,
        border-width 0.3s ease;
    }

    /* One ring leaves the station once the page has scrolled to it. */
    .quests li:target::before,
    .section:target .swatch::after {
      animation: arrive 0.9s ease-out 0.6s 2;
    }
  }

  @keyframes arrive {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--line) 70%, transparent);
    }
    to {
      box-shadow: 0 0 0 0.875rem transparent;
    }
  }

  .quests li + li::after {
    top: -1px;
  }

  .quests li::after {
    content: '';
    position: absolute;
    left: calc(var(--track) - var(--q-stroke) / 2);
    top: 0;
    bottom: calc(2 * var(--shift) - 1px);
    width: var(--q-stroke);
    background: var(--line);
  }

  /* The last entry has no track change; its line ends in a terminus bar. */
  .quests li:last-child::after {
    left: calc(var(--track) - 0.5rem);
    bottom: 0;
    width: 1rem;
    background:
      linear-gradient(var(--line) 0 0) center / var(--q-stroke) 100% no-repeat,
      linear-gradient(var(--line) 0 0) bottom / 100% var(--q-stroke) no-repeat;
  }

  .q-jog {
    position: absolute;
    left: var(--near);
    bottom: 0;
    width: var(--shift);
    height: calc(2 * var(--shift));
    overflow: visible;
    fill: none;
    stroke: var(--line);
    stroke-width: var(--q-stroke);
  }

  .q-jog path {
    vector-effect: non-scaling-stroke;
  }

  .quests li:nth-child(odd) > .q-jog:not(.q-lead) {
    scale: -1 1;
  }

  .q-lead {
    bottom: 100%;
    stroke-linecap: round;
  }

  /*
    Wide screens: entries sit either side of the line, so the list fills the column under the
    heading. Each station starts a row; an entry runs until the next one on its side, and a
    segment per row draws the line and any track change.
  */
  @media (min-width: 56rem) {
    @supports (grid-template-rows: subgrid) {
      #quests {
        row-gap: 0;
      }

      .q-head {
        grid-column: 1;
        grid-row: 1 / span var(--head-span);
        margin-bottom: var(--space-6);
      }

      .quests {
        grid-column: 1 / -1;
        grid-row: 1 / span var(--rows);
        display: grid;
        grid-template-columns: subgrid;
        grid-template-rows: subgrid;
        margin-top: 0;
        padding-top: 0;
      }

      .quests li {
        --track: calc(var(--near) + var(--shift));
        grid-column: 2;
        grid-row: var(--row) / span var(--span);
      }

      .quests li.q-left {
        grid-column: 1;
        margin-right: calc(-1 * (var(--space-7) + var(--near) - var(--clear)));
        padding-left: 0;
        text-align: right;
      }

      .quests li.q-left::before {
        left: auto;
        right: calc(-1 * var(--clear) - 0.375rem);
      }

      .quests li.q-left .q-fact {
        justify-content: flex-end;
      }

      .quests li.q-left .q-text {
        margin-left: auto;
      }

      .quests li::after,
      .quests li > .q-jog:not(.q-lead) {
        display: none;
      }

      .q-seg {
        --track: var(--near);
        display: block;
        position: relative;
        grid-column: 2;
        grid-row: var(--row);
        align-self: stretch;
        justify-self: start;
        width: calc(var(--near) + var(--shift));
        min-height: calc(2 * var(--shift) + var(--space-5));
        pointer-events: none;
      }

      .q-seg.q-on-right {
        --track: calc(var(--near) + var(--shift));
      }

      .q-seg::before {
        content: '';
        position: absolute;
        left: calc(var(--track) - var(--q-stroke) / 2);
        top: 0;
        bottom: calc(2 * var(--shift) - 1px);
        width: var(--q-stroke);
        background: var(--line);
      }

      .q-seg.q-on-right > .q-jog {
        scale: -1 1;
      }

      .q-straight::before {
        bottom: 0;
      }

      .q-seg-end {
        grid-row: var(--row) / span 2;
      }

      .q-seg-end::before {
        left: calc(var(--track) - 0.5rem);
        bottom: var(--space-2);
        width: 1rem;
        background:
          linear-gradient(var(--line) 0 0) center / var(--q-stroke) 100% no-repeat,
          linear-gradient(var(--line) 0 0) bottom / 100% var(--q-stroke) no-repeat;
      }
    }
  }

  .quests h3 {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
  }

  /* Number and unit read as one phrase. */
  .q-fact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.45rem;
    margin-top: var(--space-1);
  }

  .q-stat {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--line);
    font-variant-numeric: lining-nums;
  }

  .q-label {
    color: var(--muted);
  }

  .q-text {
    margin-top: var(--space-2);
    max-width: 36rem;
    text-wrap: pretty;
  }

  .prose p {
    text-wrap: pretty;
  }

  /* Footer */
  .foot {
    margin-top: var(--space-8);
    padding-block: var(--space-6) var(--space-5);
  }

  .foot h2 {
    margin-bottom: var(--space-3);
    color: var(--on-sky-muted);
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .foot .actions {
    margin-top: 0;
  }

  .fine {
    margin-top: var(--space-6);
    color: var(--on-sky-muted);
    font-size: var(--step--1);
  }
</style>
