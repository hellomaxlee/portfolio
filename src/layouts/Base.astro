---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#1f3d31" />
    <script is:inline>
      // The one script on the site: give the three lines a palette for this load.
      // Each row is a set of tones checked together in notes.txt; 0 keeps the default colours.
      (() => {
        const sets = [
          0,
          'apricot lavender mint',
          'butter rose lavender',
          'rose sand periwinkle',
          'wheat lavender mint',
          'wheat seafoam iris',
          'terracotta aqua iris',
          'coral ice iris',
          'peach lake iris',
          'marigold mint iris',
          'straw rose periwinkle',
          'cream aqua iris',
          'terracotta lavender ice',
          'butter lake iris',
        ];
        const roll = (n) => Math.floor(Math.random() * n);
        let last = -1;
        try {
          last = Number(sessionStorage.getItem('palette') ?? -1);
        } catch {}
        let pick = roll(last < 0 ? sets.length : sets.length - 1);
        if (last >= 0 && pick >= last) pick += 1;
        try {
          sessionStorage.setItem('palette', pick);
        } catch {}
        if (!sets[pick]) return;
        const tones = sets[pick].split(' ');
        for (const line of ['work', 'build', 'quest']) {
          const tone = tones.splice(roll(tones.length), 1)[0];
          const root = document.documentElement.style;
          root.setProperty('--map-' + line, 'var(--tone-' + tone + ')');
          root.setProperty('--paper-' + line, 'var(--tone-' + tone + '-ink)');
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
