---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, stat, statLabel, featured, full, links, image, imageAlt } = project.data;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article id={project.id} class:list={['card', { featured, full }]}>
  <div class="body">
    <h3>{title}</h3>
    {
      stat && (
        <p class="fact">
          <span class="stat">{stat}</span>
          <span class="label">{statLabel}</span>
        </p>
      )
    }
    <div class="blurb"><Content /></div>
    {
      links.length > 0 && (
        <ul class="links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel="noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  {
    image && (
      <figure class="screens">
        <div class="scroll" tabindex="0" role="group" aria-label="Dashboard screens, scrollable">
          <img
            src={`${base}/${image}`}
            alt={imageAlt ?? ''}
            width="196"
            height="64"
            decoding="async"
          />
        </div>
        <figcaption>Some of the screens it shows.</figcaption>
      </figure>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    scroll-margin-top: 2rem;
    transition: border-color 0.2s ease;
  }

  .card:hover,
  .card:target {
    border-color: var(--line);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  /* A station on the line: ring, then the name. */
  h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
  }

  h3::before {
    content: '';
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 3px solid var(--ink);
    background: var(--surface);
  }

  .fact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.45rem;
  }

  .stat {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--line);
    font-variant-numeric: lining-nums;
  }

  .label {
    color: var(--muted);
  }

  .blurb {
    font-size: 1rem;
    max-width: 34rem;
    text-wrap: pretty;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .screens {
    align-self: center;
    min-width: 0;
  }

  /* Exactly two CSS pixels per LED at every width; the strip scrolls sideways on a phone. */
  .scroll {
    overflow-x: auto;
    border-radius: 0.375rem;
  }

  .screens img {
    display: block;
    width: 24.5rem;
    max-width: none;
    height: auto;
    image-rendering: pixelated;
    background: var(--led-ground);
  }

  .screens figcaption {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--step--1);
  }

  /*
    The featured project: on the sky ground, with a border in the three line colours
    and a soft glow. Same size as its neighbour.
  */
  .featured {
    --line: var(--map-build);
    --focus: var(--map-work);
    border-color: transparent;
    background:
      linear-gradient(var(--sky), var(--sky)) padding-box,
      linear-gradient(115deg, var(--map-build), var(--map-work) 50%, var(--map-quest)) border-box;
    color: var(--on-sky);
    box-shadow:
      0 0 2.5rem -0.75rem color-mix(in srgb, var(--map-work) 45%, transparent),
      0 1.25rem 3rem -1.25rem color-mix(in srgb, var(--map-build) 60%, transparent);
    transition: box-shadow 0.3s ease;
  }

  .featured:hover,
  .featured:target {
    border-color: transparent;
    box-shadow:
      0 0 3.25rem -0.5rem color-mix(in srgb, var(--map-work) 60%, transparent),
      0 1.5rem 3.5rem -1rem color-mix(in srgb, var(--map-build) 75%, transparent);
  }

  .featured h3::before {
    border-color: var(--on-sky);
    background: var(--sky);
  }

  .featured .label {
    color: var(--on-sky-muted);
  }

  .featured .links a {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: var(--on-sky);
    color: var(--sky);
    text-decoration: none;
  }

  .featured .links a:hover {
    background: var(--map-work);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured {
      transition: none;
    }
  }

  .full {
    grid-column: 1 / -1;
  }

  @media (min-width: 56rem) {
    .full:has(.screens) {
      grid-template-columns: minmax(0, 1fr) 24.5rem;
      gap: var(--space-6);
    }
  }

  .full .blurb {
    max-width: 44rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
