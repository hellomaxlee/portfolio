---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, stat, statLabel, featured, full, links, panels } = project.data;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article id={project.id} class:list={['card', { featured, full }]}>
  <div class="body">
    <h3>{title}</h3>
    {
      stat && (
        <p class="fact">
          <span class="stat">{stat}</span>
          <span class="label">{statLabel}</span>
        </p>
      )
    }
    <div class="blurb"><Content /></div>
    {
      panels.length > 0 && (
        <ul class="panels">
          {panels.map((panel) => (
            <li>
              <img src={`${base}/${panel.src}`} alt={panel.alt} width="64" height="64" decoding="async" />
            </li>
          ))}
        </ul>
      )
    }
    {
      links.length > 0 && (
        <ul class="links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel="noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    scroll-margin-top: 2rem;
    transition: border-color 0.2s ease;
  }

  .card:hover,
  .card:target {
    border-color: var(--line);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  h3 {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
  }

  .fact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.45rem;
  }

  .stat {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--line);
    font-variant-numeric: lining-nums;
  }

  .label {
    color: var(--muted);
  }

  .blurb {
    font-size: 1rem;
    max-width: 34rem;
    text-wrap: pretty;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--step--1);
    font-weight: 600;
  }

  /* The LED screens, each 64 pixels a side, in one row that folds to two on a phone. */
  .panels {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.25rem;
    max-width: 65.75rem;
    margin-top: var(--space-2);
  }

  .panels img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.25rem;
    image-rendering: pixelated;
    background: var(--led-ground);
  }

  @media (max-width: 48rem) {
    .panels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* The featured project: a plain card whose outline runs through the three line colours. */
  .featured,
  .featured:hover,
  .featured:target {
    border-color: transparent;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(115deg, var(--line-build), var(--line-work) 50%, var(--line-quest)) border-box;
  }

  .full {
    grid-column: 1 / -1;
  }

  .full .blurb {
    max-width: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }

  /* Arriving from the map: one ring leaves the card's edge, then it rests. */
  @media (prefers-reduced-motion: no-preference) {
    .card:target {
      animation: card-arrive 0.9s ease-out 0.6s 2;
    }
  }

  @keyframes card-arrive {
    from {
      outline: 2px solid var(--line);
      outline-offset: 0;
    }
    to {
      outline: 2px solid transparent;
      outline-offset: 0.75rem;
    }
  }
</style>
